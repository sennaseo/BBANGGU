# BBANGGU 통합 환경변수 템플릿 (docker compose 용) — 복사해서 .env 로 만들고 값을 채우세요
# 로컬: docker compose --env-file .env up -d
# 서버: FRONT_BASE_URL/KAKAO_REDIRECT_URI 를 서버 주소 기준으로 바꿀 것

# --- DB ---
DB_NAME=bbanggu
DB_USERNAME=bbanggu
DB_PASSWORD=
DB_ROOT_PASSWORD=

# --- JWT ---
JWT_SECRET_ACCESS=
JWT_SECRET_REFRESH=

# --- 외부 서비스 키 ---
OPENAI_API_KEY=
REST_API_KEY=
KAKAO_CLIENT_ID=
TOSS_API_KEY=
MAIL_USERNAME=
MAIL_PASSWORD=

# --- 주소 (배포 환경에 맞게) ---
# 로컬:  http://localhost:8081/oauth/kakao/callback  /  http://localhost:5173
# 서버:  http://<서버IP 또는 도메인>/api/oauth/kakao/callback  /  http://<서버IP 또는 도메인>
#   → 바꾼 값은 카카오 개발자 콘솔 Redirect URI에도 등록해야 함
KAKAO_REDIRECT_URI=http://localhost:8081/oauth/kakao/callback
FRONT_BASE_URL=http://localhost:5173

# --- 프론트 빌드(web 서비스)용 ---
VITE_KAKAO_MAP_API_KEY=

# --- HTTPS 배포용 (도메인 있을 때만) ---
# deploy/enable-https.sh 로 인증서 발급 후, 여기 도메인을 넣으면 redeploy가 nginx conf를 자동 치환
# DOMAIN=168-110-54-87.sslip.io
